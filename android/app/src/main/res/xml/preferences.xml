<?xml version="1.0" encoding="utf-8"?>
<androidx.preference.PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <PreferenceCategory app:title="Font &amp; Text Sizing Settings">
        <SeekBarPreference
            app:key="pref_body_font_size"
            app:title="Body Text Size (px)"
            app:summary="Adjust font size for regular editor text"
            app:min="12"
            android:max="32"
            app:defaultValue="16"
            app:showSeekBarValue="true" />

        <SeekBarPreference
            app:key="pref_heading_scale_percent"
            app:title="Heading Size Scale (%)"
            app:summary="Scales all heading levels relative to text"
            app:min="50"
            android:max="200"
            app:defaultValue="100"
            app:showSeekBarValue="true" />
    </PreferenceCategory>

    <PreferenceCategory app:title="Text &amp; Element Colors (Hex Codes)">
        <EditTextPreference
            app:key="pref_bold_color"
            app:title="Bold Text Color"
            app:summary="Hex color code (e.g. #FFD700 or default)"
            app:defaultValue="default" />

        <EditTextPreference
            app:key="pref_italic_color"
            app:title="Italic Text Color"
            app:summary="Hex color code (e.g. #00E676 or default)"
            app:defaultValue="default" />

        <EditTextPreference
            app:key="pref_link_color"
            app:title="Link Color"
            app:summary="Hex color code for hyperlink text (e.g. #29B6F6 or default)"
            app:defaultValue="default" />

        <EditTextPreference
            app:key="pref_code_color"
            app:title="Inline Code Text Color"
            app:summary="Hex color code for inline code text (e.g. #FF80AB or default)"
            app:defaultValue="default" />

        <EditTextPreference
            app:key="pref_code_bg_color"
            app:title="Inline Code Background Color"
            app:summary="Hex color code for inline code background (e.g. #212121 or default)"
            app:defaultValue="default" />

        <EditTextPreference
            app:key="pref_code_block_color"
            app:title="Code Block Text Color"
            app:summary="Hex color code for code block text (e.g. #E0E0E0 or default)"
            app:defaultValue="default" />

        <EditTextPreference
            app:key="pref_code_block_bg_color"
            app:title="Code Block Background Color"
            app:summary="Hex color code for code block background (e.g. #121212 or default)"
            app:defaultValue="default" />
    </PreferenceCategory>

    <PreferenceCategory app:title="App Display &amp; Theme Settings">
        <ListPreference
            app:key="pref_app_theme"
            app:title="App Theme"
            app:summary="Select dark amoled or light mode"
            app:entries="@array/pref_theme_entries"
            app:entryValues="@array/pref_theme_values"
            app:defaultValue="amoled" />
    </PreferenceCategory>

    <PreferenceCategory app:title="Image Settings">
        <ListPreference
            app:key="pref_image_mode"
            app:title="Image Insertion Mode"
            app:summary="Select how images are added to document"
            app:entries="@array/pref_image_mode_entries"
            app:entryValues="@array/pref_image_mode_values"
            app:defaultValue="picker" />
    </PreferenceCategory>

    <PreferenceCategory app:title="Editor Plugins &amp; Toolbar Tools">
        <SwitchPreferenceCompat
            app:key="pref_plugin_heading"
            app:title="Headings"
            app:summary="Heading 1 to Heading 6 support"
            app:defaultValue="true" />

        <SwitchPreferenceCompat
            app:key="pref_plugin_bold"
            app:title="Bold"
            app:defaultValue="true" />

        <SwitchPreferenceCompat
            app:key="pref_plugin_italic"
            app:title="Italic"
            app:defaultValue="true" />

        <SwitchPreferenceCompat
            app:key="pref_plugin_strikethrough"
            app:title="Strikethrough"
            app:defaultValue="true" />

        <SwitchPreferenceCompat
            app:key="pref_plugin_highlight"
            app:title="Highlight / Markers"
            app:defaultValue="true" />

        <SwitchPreferenceCompat
            app:key="pref_plugin_code"
            app:title="Inline Code"
            app:defaultValue="true" />

        <SwitchPreferenceCompat
            app:key="pref_plugin_link"
            app:title="Links"
            app:defaultValue="true" />

        <SwitchPreferenceCompat
            app:key="pref_plugin_image"
            app:title="Images"
            app:defaultValue="true" />

        <SwitchPreferenceCompat
            app:key="pref_plugin_blockQuote"
            app:title="Block Quotes"
            app:defaultValue="true" />

        <SwitchPreferenceCompat
            app:key="pref_plugin_codeBlock"
            app:title="Code Blocks"
            app:defaultValue="true" />

        <SwitchPreferenceCompat
            app:key="pref_plugin_table"
            app:title="Tables"
            app:defaultValue="true" />

        <SwitchPreferenceCompat
            app:key="pref_plugin_list"
            app:title="Lists (Bulleted &amp; Numbered)"
            app:defaultValue="true" />

        <SwitchPreferenceCompat
            app:key="pref_plugin_todoList"
            app:title="Task / To-Do Lists"
            app:defaultValue="true" />

        <SwitchPreferenceCompat
            app:key="pref_plugin_horizontalLine"
            app:title="Horizontal Line"
            app:defaultValue="true" />

        <SwitchPreferenceCompat
            app:key="pref_plugin_sourceEditing"
            app:title="Source Editing Mode"
            app:defaultValue="true" />

        <SwitchPreferenceCompat
            app:key="pref_plugin_findAndReplace"
            app:title="Find and Replace"
            app:defaultValue="true" />
    </PreferenceCategory>

</androidx.preference.PreferenceScreen>
