<?xml version="1.0" encoding="utf-8"?>
<androidx.preference.PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <PreferenceCategory app:title="Font &amp; Text Sizing Settings">
        <SeekBarPreference
            app:key="pref_body_font_size"
            app:title="Body Text Size (px)"
            app:summary="Adjust font size for regular editor text"
            app:min="12"
            android:max="32"
            app:defaultValue="16"
            app:showSeekBarValue="true" />

        <SeekBarPreference
            app:key="pref_heading_scale_percent"
            app:title="Heading Size Scale (%)"
            app:summary="Scales all heading levels relative to text"
            app:min="50"
            android:max="200"
            app:defaultValue="100"
            app:showSeekBarValue="true" />
    </PreferenceCategory>

    <PreferenceCategory app:title="Text &amp; Element Colors (Hex Codes)">
        <EditTextPreference
            app:key="pref_bold_color"
            app:title="Bold Text Color"
            app:summary="Hex color code (e.g. #FFD700 or default)"
            app:defaultValue="default" />

        <EditTextPreference
            app:key="pref_italic_color"
            app:title="Italic Text Color"
            app:summary="Hex color code (e.g. #00E676 or default)"
            app:defaultValue="default" />

        <EditTextPreference
            app:key="pref_link_color"
            app:title="Link Color"
            app:summary="Hex color code for hyperlink text (e.g. #29B6F6 or default)"
            app:defaultValue="default" />

        <EditTextPreference
            app:key="pref_code_color"
            app:title="Inline Code Text Color"
            app:summary="Hex color code for inline code text (e.g. #FF80AB or default)"
            app:defaultValue="default" />

        <EditTextPreference
            app:key="pref_code_bg_color"
            app:title="Inline Code Background Color"
            app:summary="Hex color code for inline code background (e.g. #212121 or default)"
            app:defaultValue="default" />

        <EditTextPreference
            app:key="pref_code_block_color"
            app:title="Code Block Text Color"
            app:summary="Hex color code for code block text (e.g. #E0E0E0 or default)"
            app:defaultValue="default" />

        <EditTextPreference
            app:key="pref_code_block_bg_color"
            app:title="Code Block Background Color"
            app:summary="Hex color code for code block background (e.g. #121212 or default)"
            app:defaultValue="default" />
    </PreferenceCategory>

    <PreferenceCategory app:title="App Display &amp; Theme Settings">
        <ListPreference
            app:key="pref_app_theme"
            app:title="App Theme"
            app:summary="Select dark amoled or light mode"
            app:entries="@array/pref_theme_entries"
            app:entryValues="@array/pref_theme_values"
            app:defaultValue="amoled" />
    </PreferenceCategory>

    <PreferenceCategory app:title="Image Settings">
        <ListPreference
            app:key="pref_image_mode"
            app:title="Image Insertion Mode"
            app:summary="Select how images are added to document"
            app:entries="@array/pref_image_mode_entries"
            app:entryValues="@array/pref_image_mode_values"
            app:defaultValue="picker" />
    </PreferenceCategory>

    <PreferenceCategory app:title="Home Screen Widget Settings">
        <Preference
            app:key="pref_widget_manage"
            app:title="Manage Widget Notes"
            app:summary="Add, reorder, or remove Markdown notes for the Home Screen Widget">
            <intent
                android:targetPackage="com.ckeditor.markdownapp"
                android:targetClass="com.ckeditor.markdownapp.WidgetSettingsActivity" />
        </Preference>
    </PreferenceCategory>

    <PreferenceCategory app:title="Custom Keyboard Shortcuts (App Actions)">
        <EditTextPreference
            app:key="pref_hotkey_new"
            app:title="New Document Shortcut"
            app:summary="Key combination (e.g. ctrl+n)"
            app:defaultValue="ctrl+n" />

        <EditTextPreference
            app:key="pref_hotkey_open"
            app:title="Open Document Shortcut"
            app:summary="Key combination (e.g. ctrl+o)"
            app:defaultValue="ctrl+o" />

        <EditTextPreference
            app:key="pref_hotkey_save"
            app:title="Save Document Shortcut"
            app:summary="Key combination (e.g. ctrl+s)"
            app:defaultValue="ctrl+s" />

        <EditTextPreference
            app:key="pref_hotkey_save_as"
            app:title="Save As Shortcut"
            app:summary="Key combination (e.g. ctrl+shift+s)"
            app:defaultValue="ctrl+shift+s" />

        <EditTextPreference
            app:key="pref_hotkey_image"
            app:title="Insert Image Shortcut"
            app:summary="Key combination (e.g. ctrl+shift+i)"
            app:defaultValue="ctrl+shift+i" />

        <EditTextPreference
            app:key="pref_hotkey_settings"
            app:title="Open Settings Shortcut"
            app:summary="Key combination (e.g. ctrl+,)"
            app:defaultValue="ctrl+," />

        <EditTextPreference
            app:key="pref_hotkey_toggle_toolbar"
            app:title="Toggle Bottom Toolbar Shortcut"
            app:summary="Key combination (e.g. ctrl+t)"
            app:defaultValue="ctrl+t" />
    </PreferenceCategory>

    <PreferenceCategory app:title="Custom Keyboard Shortcuts (Formatting &amp; Tools)">
        <EditTextPreference
            app:key="pref_hotkey_bold"
            app:title="Bold Shortcut"
            app:defaultValue="ctrl+b" />

        <EditTextPreference
            app:key="pref_hotkey_italic"
            app:title="Italic Shortcut"
            app:defaultValue="ctrl+i" />

        <EditTextPreference
            app:key="pref_hotkey_strikethrough"
            app:title="Strikethrough Shortcut"
            app:defaultValue="ctrl+shift+x" />

        <EditTextPreference
            app:key="pref_hotkey_code"
            app:title="Inline Code Shortcut"
            app:defaultValue="ctrl+e" />

        <EditTextPreference
            app:key="pref_hotkey_link"
            app:title="Link Shortcut"
            app:defaultValue="ctrl+k" />

        <EditTextPreference
            app:key="pref_hotkey_blockQuote"
            app:title="Block Quote Shortcut"
            app:defaultValue="ctrl+shift+q" />

        <EditTextPreference
            app:key="pref_hotkey_codeBlock"
            app:title="Code Block Shortcut"
            app:defaultValue="ctrl+shift+c" />

        <EditTextPreference
            app:key="pref_hotkey_bulletedList"
            app:title="Bulleted List Shortcut"
            app:defaultValue="ctrl+shift+8" />

        <EditTextPreference
            app:key="pref_hotkey_numberedList"
            app:title="Numbered List Shortcut"
            app:defaultValue="ctrl+shift+7" />

        <EditTextPreference
            app:key="pref_hotkey_todoList"
            app:title="To-Do List Shortcut"
            app:defaultValue="ctrl+shift+l" />

        <EditTextPreference
            app:key="pref_hotkey_horizontalLine"
            app:title="Horizontal Line Shortcut"
            app:defaultValue="ctrl+shift+h" />

        <EditTextPreference
            app:key="pref_hotkey_findAndReplace"
            app:title="Find &amp; Replace Shortcut"
            app:defaultValue="ctrl+f" />

        <EditTextPreference
            app:key="pref_hotkey_sourceEditing"
            app:title="Source Code View Shortcut"
            app:defaultValue="ctrl+shift+u" />
    </PreferenceCategory>

    <PreferenceCategory app:title="Custom Keyboard Shortcuts (Headings)">
        <EditTextPreference
            app:key="pref_hotkey_heading_p"
            app:title="Paragraph / Normal Text Shortcut"
            app:defaultValue="ctrl+alt+0" />

        <EditTextPreference
            app:key="pref_hotkey_heading_1"
            app:title="Heading 1 Shortcut"
            app:defaultValue="ctrl+alt+1" />

        <EditTextPreference
            app:key="pref_hotkey_heading_2"
            app:title="Heading 2 Shortcut"
            app:defaultValue="ctrl+alt+2" />

        <EditTextPreference
            app:key="pref_hotkey_heading_3"
            app:title="Heading 3 Shortcut"
            app:defaultValue="ctrl+alt+3" />

        <EditTextPreference
            app:key="pref_hotkey_heading_4"
            app:title="Heading 4 Shortcut"
            app:defaultValue="ctrl+alt+4" />

        <EditTextPreference
            app:key="pref_hotkey_heading_5"
            app:title="Heading 5 Shortcut"
            app:defaultValue="ctrl+alt+5" />

        <EditTextPreference
            app:key="pref_hotkey_heading_6"
            app:title="Heading 6 Shortcut"
            app:defaultValue="ctrl+alt+6" />
    </PreferenceCategory>

    <PreferenceCategory app:title="Custom Keyboard Shortcuts (Highlight Markers)">
        <EditTextPreference
            app:key="pref_hotkey_highlight_yellow"
            app:title="Yellow Marker Highlight Shortcut"
            app:defaultValue="ctrl+alt+y" />

        <EditTextPreference
            app:key="pref_hotkey_highlight_green"
            app:title="Green Marker Highlight Shortcut"
            app:defaultValue="ctrl+alt+g" />

        <EditTextPreference
            app:key="pref_hotkey_highlight_pink"
            app:title="Pink Marker Highlight Shortcut"
            app:defaultValue="ctrl+alt+p" />

        <EditTextPreference
            app:key="pref_hotkey_highlight_blue"
            app:title="Blue Marker Highlight Shortcut"
            app:defaultValue="ctrl+alt+b" />

        <EditTextPreference
            app:key="pref_hotkey_highlight_remove"
            app:title="Remove Highlight Shortcut"
            app:defaultValue="ctrl+alt+r" />
    </PreferenceCategory>

    <PreferenceCategory app:title="Editor Plugins &amp; Toolbar Tools">
        <SwitchPreferenceCompat
            app:key="pref_plugin_heading"
            app:title="Headings"
            app:summary="Heading 1 to Heading 6 support"
            app:defaultValue="true" />

        <SwitchPreferenceCompat
            app:key="pref_plugin_bold"
            app:title="Bold"
            app:defaultValue="true" />

        <SwitchPreferenceCompat
            app:key="pref_plugin_italic"
            app:title="Italic"
            app:defaultValue="true" />

        <SwitchPreferenceCompat
            app:key="pref_plugin_strikethrough"
            app:title="Strikethrough"
            app:defaultValue="true" />

        <SwitchPreferenceCompat
            app:key="pref_plugin_highlight"
            app:title="Highlight / Markers"
            app:defaultValue="true" />

        <SwitchPreferenceCompat
            app:key="pref_plugin_code"
            app:title="Inline Code"
            app:defaultValue="true" />

        <SwitchPreferenceCompat
            app:key="pref_plugin_link"
            app:title="Links"
            app:defaultValue="true" />

        <SwitchPreferenceCompat
            app:key="pref_plugin_image"
            app:title="Images"
            app:defaultValue="true" />

        <SwitchPreferenceCompat
            app:key="pref_plugin_blockQuote"
            app:title="Block Quotes"
            app:defaultValue="true" />

        <SwitchPreferenceCompat
            app:key="pref_plugin_codeBlock"
            app:title="Code Blocks"
            app:defaultValue="true" />

        <SwitchPreferenceCompat
            app:key="pref_plugin_table"
            app:title="Tables"
            app:defaultValue="true" />

        <SwitchPreferenceCompat
            app:key="pref_plugin_list"
            app:title="Lists (Bulleted &amp; Numbered)"
            app:defaultValue="true" />

        <SwitchPreferenceCompat
            app:key="pref_plugin_todoList"
            app:title="Task / To-Do Lists"
            app:defaultValue="true" />

        <SwitchPreferenceCompat
            app:key="pref_plugin_horizontalLine"
            app:title="Horizontal Line"
            app:defaultValue="true" />

        <SwitchPreferenceCompat
            app:key="pref_plugin_sourceEditing"
            app:title="Source Editing Mode"
            app:defaultValue="true" />

        <SwitchPreferenceCompat
            app:key="pref_plugin_findAndReplace"
            app:title="Find and Replace"
            app:defaultValue="true" />
    </PreferenceCategory>

</androidx.preference.PreferenceScreen>
