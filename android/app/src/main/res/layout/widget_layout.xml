<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <!-- 100% Clean Image View Flipper -->
    <AdapterViewFlipper
        android:id="@+id/widget_flipper"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:autoStart="false"
        android:loopViews="true" />

    <!-- Left 20% Invisible Touch Target for Flipping to Previous Note -->
    <LinearLayout
        android:id="@+id/widget_touch_prev"
        android:layout_width="60dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:clickable="true"
        android:focusable="true"
        android:orientation="horizontal" />

    <!-- Right 20% Invisible Touch Target for Flipping to Next Note -->
    <LinearLayout
        android:id="@+id/widget_touch_next"
        android:layout_width="60dp"
        android:layout_height="match_parent"
        android:layout_gravity="end"
        android:clickable="true"
        android:focusable="true"
        android:orientation="horizontal" />

    <TextView
        android:id="@+id/widget_empty_text"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:text="No Widget Notes Configured"
        android:textColor="#888888"
        android:textSize="13sp"
        android:visibility="gone" />

</FrameLayout>
